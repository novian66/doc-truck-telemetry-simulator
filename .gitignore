# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Logs
*.log

# Runtime simulation telemetry logs (large data stream generated by runs)
data/trips/*.jsonl
data/cache_routes/*
!data/cache_routes/.gitkeep
!data/trips/.gitkeep

# Active SQLite database (auto-generated & auto-seeded on startup by db_manager)
data/metadata.db
data/metadata.db-journal

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
